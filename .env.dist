# Set how many attempts are allowed before an account becomes locked.
AUTH_ATTETMPTS_ALLOWED=3

# How often to report sump sensor status to the console.
CONSOLE_REPORT_FREQ_SECS=5

# Set this to the URL of the SQLite database.
DATABASE_PATH="./rpsump.db"
# For Diesel
DATABASE_URL="./rpsump.db"

# Set this to a secure value for production.
JWT_SECRET="secret-key"

GARDEN_ENABLED=true
GARDEN_MAX_RUNTIME_SEC=1800       # cap a single run at 30 minutes
GARDEN_PROCESS_FREQ_SEC=5         # scheduler polling interval
# GPIO uses BCM pin numbering.
GARDEN_SOLENOID_PIN=25            # GPIO #25 == Pin #22

HEATER_CONTROL_PIN=10 # GPIO #10 == Pin #19

# Set the auth token for the mailer service; currently only supports SendInBlue.
MAILER_AUTH_TOKEN="mailer-token"
MAILER_ERROR_CONTACT="email@domain"
MAILER_SERVER_URL="https://api.sendinblue.com/v3/smtp/email"

POOL_PUMP_LOW_PIN=12  # GPIO #12 == Pin #32
POOL_PUMP_MED_PIN=16  # GPIO #16 == Pin #36
POOL_PUMP_HIGH_PIN=20 # GPIO #20 == Pin #38
POOL_PUMP_MAX_PIN=21  # GPIO #21 == Pin #40

PUBLIC_HOST=some-domain.com
# This can be enabled for development and functional testing, but should be
# disabled in production.
SERVER_ALLOW_LOCALHOST_CORS=false
# Comma-separated origins the browser app is served from. Required for any
# deployed front end; localhost is covered by the flag above.
SERVER_ALLOWED_ORIGINS=
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_ACCESS_TOKEN_DURATION_MINUTES=30
SERVER_REFRESH_TOKEN_DURATION_DAYS=30

SUMP_ENABLED=true
SUMP_HIGH_SENSOR_PIN=14   # GPIO #14 == Pin #8
SUMP_LOW_SENSOR_PIN=18    # GPIO #18 == Pin #12
SUMP_CONTROL_PIN=11       # GPIO #11 == Pin #23
SUMP_SHUTOFF_DELAY=2      # seconds
SUMP_PUMP_MAX_RUNTIME=60 # seconds

TELEMETRY_API_KEY="api-key"
TELEMETRY_RECEIVER_URL="https://api.honeycomb.io:443"

# Precipitation-aware skip (Open-Meteo). When disabled, schedules never skip
# for rain — set WEATHER_ENABLED=true and supply lat/lon to turn the feature on.
WEATHER_ENABLED=false
# WEATHER_LATITUDE=40.7128
# WEATHER_LONGITUDE=-74.0060
# WEATHER_PAST_HOURS=24
# WEATHER_FORECAST_HOURS=12
# WEATHER_THRESHOLD_MM=5.0
# WEATHER_FORECAST_WEIGHT=0.5
# WEATHER_ACTIVE_RAIN_MM=0.3
# WEATHER_CACHE_TTL_SECS=900
