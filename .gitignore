# Build files
/target

# Development environment secrets
.env

# Local database
*.db
*.db-shm
*.db-wal

# Coverage artifacts
lcov.info

# Production secrets for reverse proxy
deploy/.env.swag

# SWAG / fail2ban / nginx runtime config — generated by the container
deploy/config/
!deploy/config/fail2ban/
deploy/config/fail2ban/*
!deploy/config/fail2ban/jail.local
!deploy/config/fail2ban/filter.d/
deploy/config/fail2ban/filter.d/*
!deploy/config/fail2ban/filter.d/nginx-rpsump-auth.conf
!deploy/config/nginx/
deploy/config/nginx/*
!deploy/config/nginx/site-confs/
deploy/config/nginx/site-confs/*
!deploy/config/nginx/site-confs/default.conf

# Other runtime / secrets / junk
swag_config/
trash/

# GitHub personal access tokens
gh_pat*
